# Google ML Kit Backend

## Environment Variables
# Copy this file to .env and fill in the values

# Django
DJANGO_SECRET_KEY=your-super-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL)
# Vous avez créé une base googlemlkitdb dans MySQL
# Adaptez ces valeurs selon votre installation locale
DB_NAME=googlemlkitdb
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# Google Cloud (for Vision & NLP APIs)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id

# Google AI (for Gemini)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# OpenAI (optional - for GPT models)
OPENAI_API_KEY=your-openai-api-key

# Celery (optional - for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
